#include <stdbool.h>

bool isPalindrome(int x) {
    // Negative numbers are not palindromes (e.g., -121 reads as 121-)
    // Numbers ending in 0 are not palindromes, unless the number itself is 0
    if (x < 0 || (x % 10 == 0 && x != 0)) {
        return false;
    }

    int reversedHalf = 0;
    // Reverse the digits of the second half of the number
    while (x > reversedHalf) {
        reversedHalf = reversedHalf * 10 + (x % 10);
        x /= 10;
    }

    // For even lengths: x == reversedHalf (e.g., 1221 -> x = 12, reversedHalf = 12)
    // For odd lengths: x == reversedHalf / 10 to filter out the middle digit (e.g., 12321 -> x = 12, reversedHalf = 123)
    return x == reversedHalf || x == reversedHalf / 10;
}
