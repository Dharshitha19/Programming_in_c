#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    char *s;
    s = malloc(1024 * sizeof(char));
    if (scanf("%[^\n]", s) != 1) {
        free(s);
        return 0;
    }
    char *token = strtok(s, " ");
    while (token != NULL) {
        printf("%s\n", token);
        token = strtok(NULL, " "); 
    }
    free(s);   
    return 0;
}
