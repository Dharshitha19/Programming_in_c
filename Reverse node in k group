/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     struct ListNode *next;
 * };
 */

// Helper function to find the k-th node from the current position
struct ListNode* getKthNode(struct ListNode* curr, int k) {
    while (curr && k > 0) {
        curr = curr->next;
        k--;
    }
    return curr;
}

struct ListNode* reverseKGroup(struct ListNode* head, int k) {
    // 1. Create a dummy node on the stack to easily track the new head
    struct ListNode dummy;
    dummy.val = 0;
    dummy.next = head;
    
    struct ListNode* groupPrev = &dummy;

    while (1) {
        // 2. Find the k-th node of the current segment
        struct ListNode* kth = getKthNode(groupPrev, k);
        if (!kth) {
            break;
        }
        
        struct ListNode* groupNext = kth->next; // Save the start of the next group

        // 3. Reverse the current group of k nodes in-place
        struct ListNode* prev = groupNext;
        struct ListNode* curr = groupPrev->next;
        while (curr != groupNext) {
            struct ListNode* tmp = curr->next;
            curr->next = prev;
            prev = curr;
            curr = tmp;
        }

        // 4. Update the boundary links to wire the reversed group into the list
        struct ListNode* tmp = groupPrev->next;
        groupPrev->next = kth;
        groupPrev = tmp;
    }

    return dummy.next;
}
