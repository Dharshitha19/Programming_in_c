#include <stdio.h>

int main() {
    int n;
    // Read the single integer input
    if (scanf("%d", &n) != 1) {
        return 1;
    }
    
    // The grid size is always 2*n - 1
    int size = 2 * n - 1;
    
    // Loop through each row
    for (int i = 0; i < size; i++) {
        // Loop through each column
        for (int j = 0; j < size; j++) {
            
            // Find the minimum distance to any of the 4 edges
            int min_dist = i;
            if (j < min_dist) min_dist = j;
            if (size - 1 - i < min_dist) min_dist = size - 1 - i;
            if (size - 1 - j < min_dist) min_dist = size - 1 - j;
            
            // The value decreases as we move towards the center
            printf("%d ", n - min_dist);
        }
        // Move to the next line after completing a row
        printf("\n");
    }
    
    return 0;
}
